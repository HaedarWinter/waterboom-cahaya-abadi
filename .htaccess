<IfModule mod_rewrite.c>
    RewriteEngine On
    # The local XAMPP document root is the repository folder. Keep application
    # source, configuration, data, and operational files inaccessible over HTTP.
    RewriteRule ^(?:app|config|database|docs|scripts|sql|storage|resources|tests|\.git|\.agents)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|AGENTS\.md|CHANGELOG\.md|PRD\.md)$ - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Public pages are stored under public/ while local XAMPP serves the project root.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(login|reservasi|cek_booking|login-submit|guestbook-submit|review-submit|reservasi-submit|health)\.php$ public/$1.php [L]

    # Serve the public front page when Apache is pointed at the project root.
    RewriteRule ^$ public/index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

Options -Indexes
<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>
