<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect sensitive files and directories
    RewriteRule ^(?:app|config|database|docs|scripts|sql|storage|resources|tests|internal|\.git|\.agents|\.vscode)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|AGENTS\.md|CHANGELOG\.md|PRD\.md|cookies\.txt|\.DS_Store|waterboom-upload\.zip)$ - [F,L,NC]

    # Rewrite assets to public/assets if not found
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Public pages are stored under public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(login|reservasi|cek_booking|login-submit|guestbook-submit|review-submit|reservasi-submit|health)\.php$ public/$1.php [L]

    # Admin panel: serve its entry point without relying on DirectoryIndex
    RewriteRule ^admin/?$ admin/index.php [L]

    # Serve the public front page. The project root is a directory, so it must
    # not be excluded by a !-d condition (there is no root index.php).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^$ public/index.php [L]

    # All other requests go to public/index.php (SPA-style or 404 handling)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

Options -Indexes
DirectoryIndex public/index.php index.php index.html

<IfModule mod_mime.c>
    AddType image/x-icon .ico
</IfModule>

# Deny access to .env files
<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

# Deny access to sensitive files
<FilesMatch "(composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock)$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>